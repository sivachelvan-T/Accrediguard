# Render production environment
NODE_ENV=production
USE_SQLITE=false
DATABASE_URL=<SET_IN_RENDER_FROM_YOUR_RENDER_POSTGRES_DATABASE>
JWT_SECRET=<SET_IN_RENDER_TO_A_LONG_RANDOM_SECRET>
JWT_EXPIRES_IN=8h
FRONTEND_URL=https://accrediguard-ai.onrender.com
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=5
UPLOAD_DIR=./uploads
